# Firebase client config (public — safe to expose in the browser bundle)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (recommended before going live — required by transferFunds fn)
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Set to "enterprise" if you registered the web app with reCAPTCHA Enterprise
# in the console; unset uses reCAPTCHA v3.
NEXT_PUBLIC_FIREBASE_APPCHECK_PROVIDER=
# Local dev only: a debug token from App Check > Apps > Manage debug tokens.
# Set to "true" once to have the SDK print a fresh token to the browser console.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# FCM web push - generate under Project Settings > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server-only — Firebase Admin SDK service account (NEVER expose to client)
# Paste the full JSON as a single-line string, or use a path in local dev.
FIREBASE_SERVICE_ACCOUNT_KEY=
